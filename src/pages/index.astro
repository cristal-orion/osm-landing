---
// OSM Evolution: landing page built on the tasteskill 2.5.1 kit (public/assets).
// type: service · site-kind: other
// deal: hero split, nav-centre, close-type, footer-dark, rhythm space, buttons arrow, mark: the client's logo
// palette: the client's own colours through start.mjs brand (magenta #b13274 from the logo on a warm off-white,
//          ink a near-black plum), type red-hat (Red Hat Display / Red Hat Text)
// moments: word-highlight (#sfide, the entrepreneur's problems in his own words), pinned-chapters (#servizi)

const mail = 'w.giacobbe@osmvalue.it';
const mainAction = 'Richiedi la consulenza gratuita';
const mailto = `mailto:${mail}?subject=${encodeURIComponent('Richiesta consulenza gratuita')}&body=${encodeURIComponent('Buongiorno,\nvorrei fissare la consulenza gratuita con OSM Evolution.\n\nAzienda:\nSettore:\nDi cosa vorrei parlare:\n')}`;
const phone = '347 681 6015';
const tel = 'tel:+393476816015';

const percorsi = [
  ['startup', 'Startup', 'Un’idea o un’attività ai primi passi da far crescere su basi solide.', 'Giovane imprenditore che prende appunti alla scrivania'],
  ['imprenditore', 'Imprenditore', 'Un’azienda avviata che ha bisogno di organizzazione, margini e tempo.', 'Imprenditrice che rivede i documenti dell’azienda al computer'],
  ['investitore', 'Investitore', 'Un capitale da far fruttare con un metodo e un network alle spalle.', 'Investitore che consulta dati su un tablet'],
  ['passaggio-generazionale', 'Passaggio generazionale', 'L’impresa che passa alla generazione successiva senza perdere valore.', 'Imprenditore senior a colloquio con un giovane collaboratore']
];

const valori = [
  ['Libertà', 'imprese e persone capaci di scegliere il proprio percorso'],
  ['Aiuto', 'esistiamo per far crescere chi affianchiamo'],
  ['Integrità', 'coerenza tra ciò che diciamo e ciò che facciamo'],
  ['Meritocrazia', 'il valore si riconosce dai risultati'],
  ['Miglioramento continuo', 'ogni giorno un passo avanti'],
  ['Allegria', 'si lavora e si cresce meglio in un clima positivo'],
  ['Fiducia', 'la base di ogni relazione che dura nel tempo']
];

const team = [
  ['/images/team/walter-giacobbe.webp', 'Walter Giacobbe', 'Partner OSM Evolution'],
  ['/images/team/nunzia-giordano.webp', 'Nunzia M. Giordano', 'Partner OSM Evolution']
];

const arrow = '<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg>';
---

<!doctype html>
<html lang="it" data-type="service" data-radius="soft" data-buttons="arrow" data-motion>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>OSM Evolution: consulenza aziendale per imprenditori e PMI</title>
<meta name="description" content="Selezione del personale, formazione, coaching e organizzazione per piccole e medie imprese, con il metodo Open Source Management. Il primo incontro è gratuito.">
<meta property="og:type" content="website">
<meta property="og:title" content="OSM Evolution: consulenza aziendale per imprenditori e PMI">
<meta property="og:description" content="Persone, organizzazione e numeri: il metodo Open Source Management per far crescere la tua impresa.">
<meta property="og:image" content="/share.jpg">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" href="/favicon.png?v=2">
<meta name="theme-color" content="#f6f3ef">
<!-- <link rel="canonical" href="https://[dominio del cliente]/"> -->
<meta name="site-kind" content="other">
<meta name="page-type" content="service">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@400..700&family=Red+Hat+Text:wght@400..600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/system.css">
<link rel="stylesheet" href="/assets/ui/cards.css">
<link rel="stylesheet" href="/assets/motion/motion.css">
<link rel="stylesheet" href="/assets/layout/layout.css">
<link rel="stylesheet" href="/assets/icons/icon.css">
<style is:inline>
:root {
  --p-bg: #f6f3ef; --p-surface: #ebe5de; --p-ink: #22141d; --p-muted: #6b6065;
  --p-accent: #b13274; --p-accent-ink: #f6f3ef; --p-action: #b13274; --p-action-ink: #f6f3ef;
  --p-inv-bg: #22141d; --p-inv-surface: #2f2129; --p-inv-ink: #f6f3ef; --p-inv-muted: #9e9598;
  --p-inv-accent: #b13274; --p-inv-accent-ink: #f6f3ef; --p-inv-action: #b13274; --p-inv-action-ink: #f6f3ef;
  --font-display: "Red Hat Display", system-ui, sans-serif;
  --font-text: "Red Hat Text", system-ui, sans-serif;
  --display-weight: 400;
  --display-tracking: -0.025em;
  --display-tracking-xl: -0.035em;
}
/* page CSS: the client's raster logo in the bar and the footer */
.nav__logo img { display: block; height: 56px; width: auto; }
.footer .nav__logo img { height: 72px; }
@media (max-width: 639px) { .nav__logo img { height: 44px; } .footer .nav__logo img { height: 64px; } }
/* the statement beside its photograph */
#sfide .frame { height: min(560px, var(--ly-fit, 560px)); }
#sfide .frame > img { width: 100%; height: 100%; object-fit: cover; }
/* the peek list's rows: a name and one line */
/* values read across: the name, then its line */
.valori > li { grid-template-columns: 13.5rem minmax(0, 1fr); padding-block: var(--s-3); }
.valori > li > span:last-child { color: var(--ink); }
@media (max-width: 639px) { .valori > li { grid-template-columns: minmax(0, 1fr); } }
/* on a tablet or a short window every section, the hero included, grows with its content instead of spilling into the next one */
@media (max-width: 1279px), (max-height: 820px) { #percorsi .grid.fill { flex: 0 0 auto; } }
@media (max-width: 1023px) {
  main > .hero { height: auto; min-height: 100svh; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: 1fr; grid-auto-rows: auto; }
  main > .hero > .wrap { height: auto; }
}
@media (min-width: 1024px) and (max-height: 820px) {
  main > .hero { height: auto; min-height: 100svh; }
  main > .hero > .wrap { height: auto; }
  .hero--split .hero__media { min-height: 460px; }
}
@media (min-width: 1280px) and (max-height: 820px) {
  main > :is(section, .section):not(.hero), footer.closing { height: auto; min-height: calc(var(--h, 1) * 100svh); display: flex; flex-direction: column; }
  main > :is(section, .section):not(.hero) > :is(.wrap, .container), footer.closing > .wrap { flex: 1 0 auto; height: auto; min-height: 0; }
}
@media (min-width: 1024px) { #percorsi .frame { min-height: 380px; } }
/* tablet: the list and its photograph side by side, so the section stays within its screens; phone: stacked, the photograph keeps its portrait shape */
@media (min-width: 640px) and (max-width: 1023px) {
  #percorsi .grid.fill { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--gutter); align-items: stretch; }
  #percorsi .grid.fill > * { grid-column: auto; }
  #percorsi .frame { height: auto; aspect-ratio: auto; max-width: none; margin-top: 0; min-height: 340px; }
}
@media (max-width: 639px) { #percorsi .frame { flex: none; height: auto; aspect-ratio: 4 / 5; max-width: 414px; margin-top: var(--s-7); } }
/* the portraits stand as tall as the values beside them */
#chi-siamo .tile { align-self: stretch; grid-template-rows: minmax(0, 1fr) auto; }
#chi-siamo .tile__media { aspect-ratio: auto; min-height: 360px; }
@media (min-width: 640px) and (max-width: 1023px) {
  #chi-siamo .tile__media { min-height: 0; aspect-ratio: 1 / 1; }
  .closing__cta .btn--xl { height: 44px; min-height: 44px; font-size: var(--t-body); width: auto; }
}
@media (min-width: 640px) and (max-width: 799px) { #chi-siamo { --h: 2; } }
/* phone: the footer drops the link column that repeats the menu, so the close fits one screen */
@media (max-width: 639px) { .footer__nav, .footer .footer__lede { display: none; } }
/* tablet: the logo on its own row, the two link columns on the page's left line and split line */
@media (min-width: 640px) and (max-width: 1023px) {
  .closing__links .grid > .stack-5 { grid-column: 1 / -1; }
  .closing__links .grid > .footer__col { grid-column: span 6; }
}
/* the close's big button wraps its label on a narrow phone */
@media (max-width: 639px) { .closing__cta .btn--xl { white-space: normal; text-align: center; } }
@media (max-width: 1023px) { #sfide .frame { height: auto; aspect-ratio: 16 / 10; margin-top: var(--s-7); } }
</style>
<script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
<script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
<link rel="modulepreload" href="/assets/moments/moments.js">
<link rel="modulepreload" href="/assets/moments/lib.js">
<link rel="modulepreload" href="/assets/moments/word-highlight/moment.js">
<link rel="modulepreload" href="/assets/moments/pinned-chapters/moment.js">
</head>
<body>
<header class="nav nav--centre">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Vai al contenuto</a>
    <a class="nav__logo" href="#top"><img src="/images/logo-osm-nav.webp" alt="OSM Salerno" width="320" height="165"></a>
    <nav class="nav__links" aria-label="Menu principale">
      <div class="nav__item"><a class="nav__link" href="#sfide">Sfide</a></div>
      <div class="nav__item"><a class="nav__link" href="#percorsi">Percorsi</a></div>
      <div class="nav__item"><a class="nav__link" href="#servizi">Servizi</a></div>
      <div class="nav__item"><a class="nav__link" href="#chi-siamo">Chi siamo</a></div>
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href={mailto}>{mainAction}</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
  </div>
</header>

<main id="top">
  <section class="hero hero--split" data-enter aria-labelledby="hero-h">
    <div class="wrap"><div class="hero-text grid hero__grid">
      <div class="hero__text span-5">
        <p class="hero__kicker"><span class="dot" aria-hidden="true"></span>Network nazionale Open Source Management</p>
        <h1 id="hero-h">Consulenza per imprenditori e PMI</h1>
        <p class="hero__lead">Selezione del personale, formazione, coaching e organizzazione, con oltre 25 anni di metodo OSM alle spalle. Il primo incontro è gratuito.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={mailto}>{mainAction}<Fragment set:html={arrow} /></a>
          <a class="btn btn--secondary" href="#servizi">Vedi i servizi</a>
        </div>
      </div>
      <div class="hero__media span-6 start-7">
        <img src="/images/hero-osm.webp" alt="Un gruppo di lavoro intorno a un tavolo con documenti e grafici durante una riunione" width="1916" height="821" style="--ly-pos: 72% 50%" fetchpriority="high">
        <div class="ly-float">
          <div class="ly-float__row"><span>Partner OSM Evolution</span></div>
          <div class="ly-float__title">Walter Giacobbe e Nunzia M. Giordano</div>
        </div>
      </div>
    </div></div>
  </section>

  <!-- word-highlight: the problems, in the words entrepreneurs use, turning to ink as they cross the screen -->
  <section class="section" id="sfide" data-moment="word-highlight" aria-labelledby="sfide-h">
    <div class="wrap grid grid--top">
      <div class="span-6 stack-5">
        <h2 id="sfide-h" class="t-label">Le sfide che ci portano gli imprenditori</h2>
        <p class="mo-wh__text">Lavori troppe ore, fatichi a trovare e trattenere collaboratori validi, vorresti delegare ma non ti fidi, e quando devi decidere i <strong>numeri</strong> non sono chiari.</p>
        <p>Sono i problemi che sentiamo più spesso. Con il metodo OSM diventano il punto da cui ripartire.</p>
      </div>
      <figure class="frame frame--photo span-6 start-7"><img src="/images/sfide.webp" alt="Un imprenditore e una consulente esaminano insieme dei documenti alla scrivania" width="1400" height="901" loading="lazy"></figure>
    </div>
  </section>

  <section class="section" id="percorsi" style="--hm: 2" aria-labelledby="percorsi-h">
    <div class="wrap">
      <div class="section-head"><h2 id="percorsi-h">Un percorso per ogni punto di partenza</h2><p>Il lavoro parte da dove sei oggi, non da un pacchetto uguale per tutti.</p></div>
      <div class="grid grid--top fill" data-peek>
        <ul class="rows span-6">
          {percorsi.map(([key, name, line]) => (
            <li data-peek-to={key} tabindex="0"><span class="rows__name">{name}</span><p>{line}</p></li>
          ))}
        </ul>
        <div class="frame frame--photo frame--fill span-6 start-7">
          {percorsi.map(([key, , , alt], i) => (
            <img class="frame__img" data-peek-for={key} src={`/images/percorso-${key}.webp`} alt={alt} width="414" height="517" hidden={i > 0}>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- pinned-chapters: the section holds for two screens while the two groups of services open one at a time -->
  <section class="section" id="servizi" style="--h: 2" data-moment="pinned-chapters" aria-labelledby="servizi-h">
    <div class="wrap mo-pc__grid">
      <div class="mo-pc__text">
        <h2 id="servizi-h">Servizi per persone, crescita e organizzazione</h2>
        <ol class="mo-pc__steps">
          <li class="mo-pc__step">
            <h3>Le persone giuste nei ruoli giusti</h3>
            <p>Selezione del personale allineato ai valori dell’impresa, assessment di potenziale e clima del team, employer branding per attirare i talenti migliori.</p>
            <figure class="mo-pc__visual"><img src="/images/servizi.webp" alt="Una riunione di lavoro intorno a un tavolo con documenti e appunti" width="1400" height="788"></figure>
          </li>
          <li class="mo-pc__step">
            <h3>Formazione, coaching e organizzazione</h3>
            <p>Percorsi pratici per imprenditori, manager e team commerciali, affiancamento su leadership e delega, processi e ruoli chiari, numeri leggibili.</p>
            <figure class="mo-pc__visual"><img src="/images/metodo.webp" alt="Un consulente guida una sessione di lavoro con un piccolo gruppo in ufficio" width="1400" height="1050"></figure>
          </li>
        </ol>
      </div>
      <div class="mo-pc__visuals frame"></div>
    </div>
  </section>

  <section class="section" id="chi-siamo" style="--hm: 2" aria-labelledby="chi-h">
    <div class="wrap grid grid--top">
      <div class="span-6">
        <div class="section-head">
          <h2 id="chi-h">Chi siamo e i valori di OSM</h2>
          <p>OSM Evolution fa parte del network nazionale Open Source Management, con oltre 2.000 aziende seguite in Italia.</p>
        </div>
        <ul class="rows valori">
          {valori.map(([name, line]) => (
            <li><span class="rows__name">{name}</span><span>{line}</span></li>
          ))}
        </ul>
      </div>
      {team.map(([src, name, role], i) => (
          <article class={`tile tile--portrait span-3${i === 0 ? ' start-7' : ''}`}>
            <div class="tile__media"><img src={src} alt={`Ritratto di ${name}`} width="800" height="1000" loading="lazy"></div>
            <div><h3>{name}</h3><p class="t-small muted">{role}</p></div>
          </article>
      ))}
    </div>
  </section>
</main>

<footer class="footer closing footer--dark ground-inverse" id="contact" aria-labelledby="close-h">
  <div class="wrap">
    <div class="closing__cta close--type">
      <div class="section-head">
        <h2 id="close-h">{mainAction}</h2>
        <p>Raccontaci dove vuoi portare la tua azienda. Scrivi a Walter Giacobbe o chiama il {phone}.</p>
      </div>
      <a class="btn btn--primary btn--xl" href={mailto}>{mainAction}<Fragment set:html={arrow} /></a>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-6 stack-5">
          <a class="nav__logo" href="#top"><img src="/images/logo-osm-nav.webp" alt="OSM Salerno" width="320" height="165"></a>
          <p class="footer__lede">Consulenza, formazione e selezione del personale per le PMI.</p>
        </div>
        <div class="span-3 start-7 footer__col footer__nav"><h3>Pagina</h3><ul><li><a href="#sfide">Sfide</a></li><li><a href="#percorsi">Percorsi</a></li><li><a href="#servizi">Servizi</a></li><li><a href="#chi-siamo">Chi siamo</a></li></ul></div>
        <div class="span-3 footer__col"><h3>Contatti</h3><ul><li><a href={`mailto:${mail}`}>{mail}</a></li><li><a href={tel}>{phone}</a></li></ul></div>
      </div>
      <div class="footer__legal">
        <span>&copy; 2026 OSM Evolution, network Open Source Management</span>
      </div>
    </div>
  </div>
</footer>
<nav class="actionbar" aria-label="Azioni rapide">
  <a class="btn btn--primary" href={mailto}>{mainAction}</a>
</nav>
<script is:inline type="module" src="/assets/system.js"></script>
<script is:inline type="module" src="/assets/motion/motion.js"></script>
<script is:inline type="module" src="/assets/layout/layout.js"></script>
</body>
</html>
